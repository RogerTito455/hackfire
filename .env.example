# Backend
HACKFIRE_CORS_ORIGINS=http://localhost:5173
HACKFIRE_NEIGHBORS_FILE=
# The registry itself as one line of JSON, for Railway, where the local file is not in the image.
# Holds real phone numbers: set it in Railway's variables, never in a file that is committed.
HACKFIRE_NEIGHBORS_JSON=
# Built dashboard to serve from the backend. Set in the Dockerfile; leave empty locally
HACKFIRE_DASHBOARD_DIR=
# Phone that receives a message for every new rescue
HACKFIRE_CREW_PHONE=
# Fire crews the rescue plan is shared between (default 2)
HACKFIRE_CREWS=

# Twilio, for the crew SMS on every new rescue (#9). Leave empty: alerts stay on the dashboard.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
# The fire to replay: an id of data/scenarios/<id>.json, or a path to a scenario file. Empty: el-tiemblo-2026-07-23
HACKFIRE_SCENARIO=
# Replay moment the calls happen at, and the agent's answers until the dashboard slider sets one (ISO 8601). Empty: the scenario's scenario_time
HACKFIRE_SCENARIO_TIME=
HACKFIRE_AGENT_LOCALE=
HACKFIRE_CREW_LOCALE=
# Public dashboard URL, for the link in crew alerts. Empty: http://localhost:5173
HACKFIRE_PUBLIC_URL=

# Deepfire — create an API client at https://app.deepfire.co/settings/api-clients
DEEPFIRE_CLIENT_ID=
DEEPFIRE_CLIENT_SECRET=

# SLNG — https://app.slng.ai → Projects → Generate key; ask the mentors for credits and a phone number
SLNG_API_KEY=
# The deployed resident agent (voice/README.md). Empty uses hackfire-resident-slng
SLNG_RESIDENT_AGENT_ID=
# The deployed coordinator agent (voice/coordinator/). Empty uses hackfire-coordinator-slng
SLNG_COORDINATOR_AGENT_ID=
# Vonage (#18): live video from residents who need rescue, captions and the SMS with the link.
# One application with the Video capability: its id and private key (PEM text, or a path to the .key file)
VONAGE_APPLICATION_ID=
VONAGE_PRIVATE_KEY=
# SMS sender: up to 11 letters or digits. Empty uses HackFire
VONAGE_SMS_FROM=
# 1 once an outbound SIP trunk is attached to the agent in SLNG; until then, take calls in the browser
HACKFIRE_PHONE_CALLS=
SLNG_BASE_URL=

# The backend's LLM (typed answers, pnpm eval:triage): SLNG's Context Router with SLNG_API_KEY.
# Empty uses https://eu-north.context-router.slng.ai/v1 and the agents' Nemotron Super 3.
SLNG_LLM_URL=
SLNG_LLM_MODEL=

# ElevenLabs — https://elevenlabs.io/app/settings/api-keys. Only for the presentation video (video/README.md)
ELEVENLABS_API_KEY=

# Galtea — https://platform.galtea.ai → Settings. Only for `pnpm eval:galtea` (docs/services/galtea.md)
GALTEA_API_KEY=

# openrouteservice — https://openrouteservice.org/dev/#/signup
ORS_API_KEY=

# Overpass (OpenStreetMap) — optional, used by `pnpm data:zones`. Empty means overpass-api.de;
# if it refuses connections try https://overpass.openstreetmap.fr/api/interpreter
OVERPASS_URL=

# Frontend (set in frontend/.env.local)
# VITE_API_URL=http://localhost:8000
