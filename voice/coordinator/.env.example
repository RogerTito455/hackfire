# Names only. The values live in the repo root .env; do not create a second
# real .env here. Export the key before running unmute, for example
# `set -a; . ../../.env; set +a`, or sign in once with `voiceai login`.
#
# `unmute deploy` reads SLNG_API_KEY, then VOICEAI_API_KEY, then the voiceai
# profile. The slng target reads nothing else from the environment: the model
# (Nemotron Super) is served by SLNG with no key of our own.
SLNG_API_KEY=
